# Backend (Express) environment variables
# Copy this file to .env and fill in values.

# Postgres connection string (Supabase DB)
DATABASE_URL=

# JWT signing secret for /api/auth/login
JWT_SECRET=

# Server
PORT=4000

# Frontend base URL (for Stripe redirect URLs)
CLIENT_URL=http://localhost:3000

# Stripe (optional unless using payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase (optional unless using Stripe credit updates via Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
