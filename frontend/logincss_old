/* login.css */

:root {
  --cursorX: 50vw;
  --cursorY: 50vh;
  --cursorX2: 50vw;
  --cursorY2: 50vh;
  --animationDuration: 10s;
  --animationDelay: 15s;
}

.login-container {
  min-height: 100vh;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  -webkit-transition: all 0.50s;
  transition: all 0.50s;
  font-family: 'Roboto', sans-serif; /* Consistent font with Home.css */
}

.login-container:before {
  content: '';
  position: fixed;
  display: block;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-blend-mode: normal, overlay;
  background-position: center center;
  background-size: auto, auto, cover;
  background-image:
    radial-gradient(
      circle 8vmax at var(--cursorX2) var(--cursorY2),
      rgba(0,0,0,0) 30%,
      rgba(0,5,5,.1) 40%,
      rgba(5,5,0,.5) 60%,
      rgba(0,0,0,.75) 70%,
      rgba(0,0,0,.95) 100%
    ),
    radial-gradient(
      circle 6vmax at var(--cursorX) var(--cursorY),
      rgba(255,255,255,1) 30%,
      rgba(255,255,255,.3) 50%,
      rgba(255,255,255,.05) 100%
    ),
    url('../licensed-image.jpg');
  animation: torch var(--animationDuration) linear var(--animationDelay) infinite alternate;
  z-index: -1;
}

@keyframes torch {
  0%, 1%, 2%, 3%, 4%, 5%, 20%, 21%, 60%, 61%, 62%, 100% {
    background-image:
      radial-gradient(
        circle 8vmax at var(--cursorX2) var(--cursorY2),
        rgba(0,0,0,0) 30%,
        rgba(0,5,5,.1) 40%,
        rgba(5,5,0,.5) 60%,
        rgba(0,0,0,.75) 70%,
        rgba(0,0,0,.95) 100%
      ),
      radial-gradient(
        circle 4vmax at var(--cursorX) var(--cursorY),
        rgba(255,255,255,1) 30%,
        rgba(255,255,255,.3) 50%,
        rgba(255,255,255,.05) 100%
      ),
      url('../licensed-image.jpg');
  }
  0.5%, 1.5%, 60.5% {
    background-image:
      radial-gradient(
        circle 6vmax at var(--cursorX2) var(--cursorY2),
        rgba(0,0,0,0) 30%,
        rgba(0,5,5,.1) 40%,
        rgba(5,5,0,.5) 60%,
        rgba(0,0,0,.75) 70%,
        rgba(0,0,0,.95) 100%
      ),
      radial-gradient(
        circle 3vmax at var(--cursorX) var(--cursorY),
        rgba(255,255,255,1) 30%,
        rgba(255,255,255,.3) 50%,
        rgba(255,255,255,.05) 100%
      ),
      url('../licensed-image.jpg');
  }
  2.5%, 3.5%, 4.5%, 20.5%, 61.5% {
    background-image:
      radial-gradient(
        circle 2vmax at var(--cursorX) var(--cursorY),
        rgba(0,0,0,0) 30%,
        rgba(0,5,5,.1) 40%,
        rgba(5,5,0,.5) 60%,
        rgba(0,0,0,.75) 70%,
        rgba(0,0,0,.95) 100%
      ),
      radial-gradient(
        circle 1vmax at var(--cursorX) var(--cursorY),
        rgba(255,255,255,1) 0%,
        rgba(255,255,255,.5) 50%,
        rgba(255,255,255,.05) 100%
      ),
      url('../licensed-image.jpg');
  }
}

.login-container:hover {
  border: 1px solid rgb(255, 255, 255);
  filter: brightness(130%);
  -webkit-filter: brightness(130%);
  -moz-filter: brightness(130%);
  -o-filter: brightness(130%);
  -ms-filter: brightness(130%);
  -webkit-transition: all 0.50s;
  transition: all 0.50s;
}

.login-box {
  background-color: white;
  padding: 2.5rem;
  border-radius: 0.75rem;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  width: 100%;
  max-width: 450px;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1;
  font-family: 'Roboto', sans-serif; /* Consistent font */
  position: relative; /* Needed for absolute positioning of back-link */
}

.login-content {
  width: 100%;
  text-align: center;
  position: relative; /* Ensure back-link positions relative to this */
}

.back-link {
  position: absolute;
  top: 1rem;
  left: 1rem;
  font-size: 1rem;
  color: #6c757d; /* Neutral gray to match original back-button */
  text-decoration: underline;
  cursor: pointer;
  font-family: 'Roboto', sans-serif; /* Consistent font */
  font-weight: 400; /* Medium weight */
  letter-spacing: 0.5px; /* Subtle refinement */
  text-shadow: 0 1px 1px rgba(0, 0, 0, 0.1); /* Subtle shadow */
}

.back-link:hover {
  color: #5a6268; /* Darker shade on hover, matching original back-button hover */
}

.login-content h2 {
  font-size: 1.875rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
  color: #1f2937;
  font-family: 'Roboto', sans-serif; /* Consistent font */
  font-weight: 500; /* Adjusted to match Home.css headings */
  letter-spacing: 0.5px; /* Subtle refinement */
  text-shadow: 0 1px 1px rgba(0, 0, 0, 0.1); /* Subtle shadow */
}

.input-field {
  width: 100%;
  padding: 0.75rem;
  margin-bottom: 1rem;
  border: 2px solid #e5e7eb;
  border-radius: 0.5rem;
  font-size: 1rem;
  outline: none;
  box-sizing: border-box;
  font-family: 'Roboto', sans-serif; /* Consistent font */
  font-weight: 400; /* Medium weight */
  letter-spacing: 0.5px; /* Subtle refinement */
  text-shadow: 0 1px 1px rgba(0, 0, 0, 0.1); /* Subtle shadow */
}

.input-field:focus {
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
}

.password-wrapper {
  position: relative;
  width: 100%;
  margin-bottom: 1rem;
}

.password-wrapper input {
  width: 100%;
  padding-right: 4rem;
  box-sizing: border-box;
  font-family: 'Roboto', sans-serif; /* Consistent font */
}

.password-toggle {
  position: absolute;
  right: 0.75rem;
  top: 38%;
  transform: translateY(-50%);
  font-size: 0.875rem;
  color: #2563eb;
  cursor: pointer;
  background: none;
  border: none;
  padding: 0 0.5rem;
  height: 100%;
  display: flex;
  align-items: center;
  z-index: 1;
  font-family: 'Roboto', sans-serif; /* Consistent font */
  font-weight: 400; /* Medium weight */
  letter-spacing: 0.5px; /* Subtle refinement */
}

.password-toggle:hover {
  color: #1d4ed8;
}

.submit-button {
  width: 100%;
  padding: 0.75rem;
  color: white;
  border-radius: 0.5rem;
  font-size: 1.125rem;
  font-weight: 500;
  cursor: pointer;
  margin-bottom: 1rem;
  transition: background-color 0.2s;
  padding: 0.6em 2em;
  border: none;
  outline: none;
  color: rgb(255, 255, 255);
  background: #111;
  border-radius: 10px;
  user-select: none;
  -webkit-user-select: none;
  touch-action: manipulation;
  font-family: 'Roboto', sans-serif; /* Consistent font */
  letter-spacing: 0.5px; /* Subtle refinement */
  text-shadow: 0 1px 1px rgba(0, 0, 0, 0.1); /* Subtle shadow */
}

.submit-button:hover {
  background-color: #2563eb;
}

.toggle-button {
  width: 100%;
  color: #3b82f6;
  text-align: center;
  text-decoration: underline;
  cursor: pointer;
  font-size: 1rem;
  padding: 0.6em 2em;
  border: none;
  outline: none;
  color: rgb(255, 255, 255);
  background: #111;
  border-radius: 10px;
  user-select: none;
  -webkit-user-select: none;
  touch-action: manipulation;
  font-family: 'Roboto', sans-serif; /* Consistent font */
  font-weight: 400; /* Medium weight */
  letter-spacing: 0.5px; /* Subtle refinement */
  text-shadow: 0 1px 1px rgba(0, 0, 0, 0.1); /* Subtle shadow */
}

.toggle-button:hover {
  background-color: #2563eb;
}

.warning {
  color: #dc2626;
  font-size: 0.875rem;
  margin-top: -0.75rem;
  margin-bottom: 0.75rem;
  text-align: left;
  font-family: 'Roboto', sans-serif; /* Consistent font */
  font-weight: 400; /* Medium weight */
  letter-spacing: 0.5px; /* Subtle refinement */
  text-shadow: 0 1px 1px rgba(0, 0, 0, 0.1); /* Subtle shadow */
}

.input-field {
  position: relative;
  font-size: 1.5em;
  background: linear-gradient(21deg, #10abff, #1beabd);
  padding: 3px;
  display: inline-block;
  border-radius: 9999em;
  font-family: 'Roboto', sans-serif; /* Consistent font */
}

.input-field *:not(span) {
  position: relative;
  display: inherit;
  border-radius: inherit;
  margin: 0;
  border: none;
  outline: none;
  padding: 0 .325em;
  z-index: 1;
  font-family: 'Roboto', sans-serif; /* Consistent font */
}

.input-field *:not(span):focus + span {
  opacity: 1;
  transform: scale(1);
}

.input-field span {
  transform: scale(.993, .94);
  transition: transform .5s, opacity .25s;
  opacity: 0;
  position: absolute;
  z-index: 0;
  margin: 4px;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: inherit;
  pointer-events: none;
  box-shadow: inset 0 0 0 3px #fff,
    0 0 0 4px #fff,
    3px -3px 30px #1beabd,
    -3px 3px 30px #10abff;
}

::placeholder {
  color: #fff;
  padding-left: 10px;
  font-family: 'Roboto', sans-serif; /* Consistent font */
}

/* Removed back-button styles since it's now a link */
.back-button {
  display: none; /* Hide the old button style */
}

.content-container {
  position: relative;
  z-index: 100; /* Above SmokeyCursor */
  width: 100%; /* Full width of the page */
  min-height: 100vh; /* Full height of the viewport */
  padding: 80px 20px 40px; /* Preserve top padding to clear Navbar, keep side and bottom padding */
  text-align: center;
  font-family: 'Roboto', sans-serif;
  background: rgba(255, 255, 255, 0.7); /* Maintain semi-transparent white background */
  border-radius: 8px; /* Keep rounded corners */
}