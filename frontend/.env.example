# Frontend (Create React App) environment variables
# Copy this file to .env and fill in values.

# Supabase (public / anon key is OK for frontend)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# STT service (Flask)
REACT_APP_STT_URL=http://localhost:5000

# Optional: backend base URL (the app currently uses CRA proxy for /api)
REACT_APP_BACKEND_URL=http://localhost:4000
