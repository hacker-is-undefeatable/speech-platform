# Python STT/TTS service environment variables
# Copy this file to .env and fill in values.

# Supabase
SUPABASE_URL=
# Recommended: use a SERVICE ROLE key here (server-side only)
SUPABASE_KEY=

# HuggingFace token (required for pyannote diarization model access)
HF_TOKEN=

# Server settings
HOST=0.0.0.0
PORT=5000
